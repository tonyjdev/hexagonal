  "cards": [
    {
      "dot": "cyan",
      "title": "El valor de la hexagonal",
      "items": [
        "El núcleo solo ve PlanReader: ni HTTP, ni JSON, ni Python.",
        "Leer el PDF con un LLM (nivel 15) será otro adaptador del mismo puerto.",
        "Los casos de uso de la importación se probarán con InMemoryPlanReader."
      ]
    },
    {
      "dot": "rose",
      "title": "Errores traducidos (ADR 0024)",
      "items": [
        "Excel mal formado (422 del servicio) → UnreadableDocument → 422.",
        "Conexión rechazada, timeout, 5xx o JSON fuera de contrato → PlanReaderUnavailable → 503.",
        "El usuario lee un mensaje en español; el detalle técnico va al log."
      ]
    },
    {
      "dot": "violet",
      "title": "Contract testing entre dos lenguajes",
      "items": [
        "Python falla si el contrato versionado no es lo que generan sus modelos.",
        "Laravel valida los ejemplos contra el schema y los pasa por el mapper estricto.",
        "Un cambio del JSON no llega a producción sin un test en rojo."
      ]
    }
  ]
