  "cards": [
    {
      "dot": "cyan",
      "title": "Preguntar (HEXM-0025, ADR 0017)",
      "items": [
        "MealPlanning define su puerto RecipeCatalog; el adaptador traduce la pregunta a GetRecipe.",
        "Síncrono: el alta espera la respuesta antes de guardar."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reaccionar (HEXM-0026 y 0027, ADR 0018 y 0019)",
      "items": [
        "Recipes publica RecipeDeleted sin saber quién escucha.",
        "El oyente lo traduce a UnlinkDeletedRecipe: los platos se desvinculan (regla 24).",
        "Consistencia eventual: si la reacción falla, el borrado se mantiene y el error se registra."
      ]
    },
    {
      "dot": "rose",
      "title": "La frontera, comprobada",
      "items": [
        "Recipes no conoce MealPlanning; el núcleo de MealPlanning no conoce Recipes.",
        "La infraestructura de un contexto entra en otro por su capa de aplicación o por sus eventos públicos, y nada más."
      ]
    }
  ]
