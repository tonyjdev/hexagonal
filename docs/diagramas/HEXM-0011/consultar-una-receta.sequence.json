  "cards": [
    {
      "dot": "emerald",
      "title": "Consulta (CQS) con DTO de lectura",
      "items": [
        "GetRecipe no cambia nada: se puede repetir sin efectos secundarios.",
        "Devuelve un RecipeView con primitivos; la entidad Recipe nunca llega al controlador."
      ]
    },
    {
      "dot": "rose",
      "title": "404 frente a 422",
      "items": [
        "404: el id es válido pero no hay receta (RecipeNotFound, un resultado normal).",
        "422: \"abc\" no puede ser una receta (InvalidRecipeId, del dominio). Decisión del ADR 0008."
      ]
    }
