  "cards": [
    {
      "dot": "emerald",
      "title": "Primero el dominio, después el recetario",
      "items": [
        "Las reglas del plan se comprueban en memoria antes de consultar a nadie.",
        "Al recetario se pregunta una vez por receta distinta, y solo con un plan válido."
      ]
    },
    {
      "dot": "cyan",
      "title": "Lo que traduce la capa anticorrupción",
      "items": [
        "RecipeView → true; RecipeNotFound → false.",
        "El caso de uso nunca ve nada de Recipes: solo un bool."
      ]
    },
    {
      "dot": "rose",
      "title": "Dos errores, los dos 422",
      "items": [
        "UnknownRecipe: la receta no existe (un dato del plan, no un 404).",
        "InvalidRecipeReference: ni siquiera es un id; no se llega a preguntar."
      ]
