  "cards": [
    {
      "dot": "emerald",
      "title": "Adaptador driving",
      "items": [
        "El controlador solo traduce: petición → comando → caso de uso → 201.",
        "CreateRecipe no ha cambiado: el adaptador de Eloquent llega por RecipesServiceProvider."
      ]
    },
    {
      "dot": "rose",
      "title": "Dos 422 distintos",
      "items": [
        "Con \"errors\": la petición no cumple el contrato (la para la FormRequest).",
        "Solo \"message\", en español: el negocio no lo permite (lo traduce un único manejador)."
      ]
    }
  ]
