  "cards": [
    {
      "dot": "emerald",
      "title": "Registrar, borrar y después publicar",
      "items": [
        "La receta anota el evento; el caso de uso borra y solo entonces lo publica.",
        "Con 404 o 422 el caso de uso se para antes: ni se borra ni se anuncia nada."
      ]
    },
    {
      "dot": "cyan",
      "title": "Nadie conoce al oyente",
      "items": [
        "Ni DeleteRecipe ni el bus saben quién escucha: el oyente se registra en Laravel.",
        "En HEXM-0027 será MealPlanning; hoy solo los tests."
      ]
    },
    {
      "dot": "rose",
      "title": "El riesgo que se acepta (ADR 0018)",
      "items": [
        "Si el proceso se cae entre el borrado y la publicación, el aviso se pierde.",
        "El patrón outbox lo evitaría; queda fuera de alcance."
      ]
    }
  ]
