  "cards": [
    {
      "dot": "emerald",
      "title": "Dominio: la regla; aplicación: la presentación",
      "items": [
        "NutritionPlanHistory y ValidityPeriod escriben la regla 19 una vez, sin Laravel.",
        "PlanStatus solo presenta el periodo respecto a hoy, con el Clock."
      ]
    },
    {
      "dot": "rose",
      "title": "Dos reglas entre planes en el contrato",
      "items": [
        "Un inicio por día (DuplicatedPlanStart) y un número por plan (DuplicatedPlanNumber).",
        "Si un plan choca por las dos, gana el inicio en los dos adaptadores."
      ]
    }
