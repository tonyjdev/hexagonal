  "cards": [
    {
      "dot": "emerald",
      "title": "Invariantes de la receta",
      "items": [
        "Tiene nombre (no vacío).",
        "Tiene al menos un ingrediente; uno al gusto también cuenta.",
        "No repite ingredientes: mismo nombre sin distinguir mayúsculas.",
        "Los pasos son opcionales; su orden es la posición en la lista."
      ]
    },
    {
      "dot": "cyan",
      "title": "Entidad frente a value object",
      "items": [
        "Recipe se compara por RecipeId: renombrada sigue siendo la misma receta.",
        "Ingredient, Quantity, Step, Servings y RecipeId se comparan por valor y son inmutables.",
        "Solo se entra al agregado por Recipe::create() y rename(); las listas salen como copias."
      ]
    }
  ]
