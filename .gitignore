# Datos personales reales (planes de la nutricionista): nunca se versionan
datos-personales/
*.pdf
*.xlsx
!**/tests/fixtures/**

# Sistema / editores
.DS_Store
.idea/
.vscode/

# Variables locales de docker compose (si se crean)
/.env

# Diagramas Archify (docs/diagramas): solo se versiona la fuente (*.<tipo>.json)
# y el README. El HTML (~850 KB, lleva el visor dentro) y los recibos de
# validación se regeneran con scripts/diagramas.sh (o composer docs:diagrams).
docs/diagramas/**/*.html
docs/diagramas/**/*.delivery.json
docs/diagramas/**/*.delivery-pending.json
docs/diagramas/**/*.finalize.json
docs/diagramas/**/*.finalize-summary.json
docs/diagramas/**/*.browser-check.json
docs/diagramas/**/*.visual-check.*
docs/diagramas/**/review-*/
docs/diagramas/**/visual-check/
