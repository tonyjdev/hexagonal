APP_NAME=Hexagonal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Base de datos: el PostgreSQL nativo de la máquina (ADR 0020), preparado con
# ../scripts/db-setup.sh
#
# CONCEPTO: configuración por entorno (twelve-factor)
# La aplicación no sabe dónde está la base de datos: lo lee de estas variables.
# Así el mismo código funciona en local, en CI o en un servidor, cambiando
# solo la configuración. Es el primer paso para tratar la base de datos como
# un detalle de infraestructura.
#
# Estos valores coinciden con los valores por defecto de scripts/db-setup.sh.
# Son credenciales SOLO de desarrollo local.
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hexagonal
DB_USERNAME=hexagonal
DB_PASSWORD=hexagonal

# ----------------------------------------------------------------------------
# Servicio importer (services/importer, Python + FastAPI): lee los Excel de
# un plan. Laravel lo llama a través del puerto PlanReader (HEXM-0031,
# ADR 0024). Por defecto, el de `uv run poe serve`. El timeout, en segundos.
# ----------------------------------------------------------------------------
IMPORTER_URL=http://127.0.0.1:8001
IMPORTER_TIMEOUT=10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
